# macOS Finder / resource-fork cruft (a pattern without a slash matches at any depth)
.DS_Store
._*

# graphify generated knowledge-graph output (regenerable; rebuilt by the post-commit hook)
graphify-out/

# Python / tooling caches
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.ipynb_checkpoints/
.mplconfig/
.cache/

# generated logs
*.log

# Sarukhanian report figures (generated plots — were never tracked)
sarukhanian/report/figures/

# Claude Code personal/local settings (keep out of version control; file stays on disk)
.claude/settings.local.json

# local notification topic (private)
cluster/deploy/notify.conf
results/.ntfy_found_state
results/auto_*.log
results/latest_check.txt
results/last_summary.txt
results/launchd.out
results/launchd.err
results/daily_check.log
cluster/deploy/AUTOPILOT_OFF
